# Copy this file to .env and replace both tokens before starting Compose.
PANEL_CHECKER_INTERNAL_TOKEN=replace-with-a-long-random-internal-token
PANEL_ADMIN_TOKEN=replace-with-a-different-long-random-admin-token

# Public Panel listener and the URL used by remote Receivers.
PANEL_PORT=18080
PANEL_PUBLIC_URL=http://SERVER:18080

# Loopback-only Panel listener shared by Panel and Checker. Change this when
# the default 8081 is already occupied on a host-networked Docker server.
INTERNAL_PORT=8081

# Optional bootstrap/deployment settings.
SUBSCRIPTION_URL=
TZ=UTC
XRAY_CHECKER_VERSION=latest
